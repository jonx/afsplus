 void BCPL_RunHandler(void);
 
+/*
+ * One start per DeviceNode at a time.
+ *
+ * GetDeviceProc() calls RunHandler() when dn_Task is NULL. Mount defers the
+ * start of a handler to the first access, so two tasks that make their first
+ * access to a device together both arrive here, and each used to create a
+ * handler process: two instances of a filesystem on one medium. A caller
+ * that finds a start of the same node in progress now waits for it and
+ * takes its result. Starts of different nodes stay independent, because a
+ * handler may open files on other volumes while it starts.
+ *
+ * Two callers must never wait: the handler being started, when its startup
+ * touches its own node, because the starter is waiting for that very
+ * handler; and anybody once the starter is no longer a task, because nobody
+ * would release them. The first gets the node's current dn_Task, as it did
+ * before. The second removes the dead start and starts the handler itself.
+ */
+struct HandlerStart
+{
+    struct MinNode          hs_Node;
+    struct DeviceNode      *hs_DeviceNode;
+    struct SignalSemaphore  hs_Done;     /* held by the starter until it is done */
+    struct Task            *hs_Starter;
+    struct MsgPort         *hs_Result;   /* what the starter returns; valid once hs_Done is free */
+    ULONG                   hs_Users;    /* the starter and its waiters */
+};
+
+static struct MinList handlerStarts;
+static BOOL handlerStartsReady;
+
+static void DropHandlerStart(struct HandlerStart *start)
+{
+    BOOL last;
+
+    Forbid();
+    last = --start->hs_Users == 0;
+    Permit();
+    if (last)
+        FreeMem(start, sizeof(*start));
+}
+
+/* Call under Forbid(). */
+static BOOL TaskIsListed(struct Task *task)
+{
+#if defined(__AROSEXEC_SMP__)
+    /* The task lists have their own locks there; without walking them a
+       dead starter is not detected, and its waiters wait as before. */
+    (void)task;
+    return TRUE;
+#else
+    struct Node *node;
+
+    if (task == SysBase->ThisTask)
+        return TRUE;
+    ForeachNode(&SysBase->TaskReady, node)
+        if ((struct Task *)node == task)
+            return TRUE;
+    ForeachNode(&SysBase->TaskWait, node)
+        if ((struct Task *)node == task)
+            return TRUE;
+    return FALSE;
+#endif
+}
+
+/* The process RunHandler() creates for a node runs the node's seglist. */
+static BOOL IsHandlerOfNode(struct Process *me, struct DeviceNode *deviceNode)
+{
+    BPTR *segArray = BADDR(me->pr_SegList);
+
+    return me->pr_Task.tc_Node.ln_Type == NT_PROCESS && segArray != NULL
+        && deviceNode->dn_SegList != BNULL
+        && segArray[3] == deviceNode->dn_SegList;
+}
+
+static struct MsgPort *StartHandler(struct DeviceNode *deviceNode, const char *path, struct DosLibrary *DOSBase);
+
 struct MsgPort *RunHandler(struct DeviceNode *deviceNode, const char *path, struct DosLibrary *DOSBase)
+{
+    struct HandlerStart *mine, *start, *running, *abandoned;
+    struct MsgPort *port;
+    BOOL held;
+
+    /* The handler being started asks for its own device. */
+    if (IsHandlerOfNode((struct Process *)FindTask(NULL), deviceNode))
+        return deviceNode->dn_Task;
+
+    mine = AllocMem(sizeof(*mine), MEMF_PUBLIC | MEMF_CLEAR);
+    if (mine == NULL)
+        return NULL;
+    mine->hs_DeviceNode = deviceNode;
+    mine->hs_Starter = FindTask(NULL);
+    mine->hs_Users = 1;
+    InitSemaphore(&mine->hs_Done);
+    /* Owned before it is published, so this never waits. */
+    ObtainSemaphore(&mine->hs_Done);
+
+    for (;;)
+    {
+        running = NULL;
+        abandoned = NULL;
+        Forbid();
+        if (!handlerStartsReady)
+        {
+            NEWLIST((struct List *)&handlerStarts);
+            handlerStartsReady = TRUE;
+        }
+        ForeachNode(&handlerStarts, start)
+        {
+            if (start->hs_DeviceNode == deviceNode)
+            {
+                running = start;
+                break;
+            }
+        }
+        if (running != NULL && !TaskIsListed(running->hs_Starter))
+        {
+            /* Its starter is gone and will never finish it, nor give up its
+               own reference to it. */
+            Remove((struct Node *)&running->hs_Node);
+            abandoned = running;
+            running = NULL;
+        }
+        if (running != NULL)
+            running->hs_Users++;
+        else
+            AddTail((struct List *)&handlerStarts, (struct Node *)&mine->hs_Node);
+        Permit();
+
+        if (abandoned != NULL)
+            DropHandlerStart(abandoned);
+        if (running == NULL)
+            break;
+
+        /* Wait for the start in progress, but not for a starter that died
+           while we waited. */
+        held = FALSE;
+        for (;;)
+        {
+            BOOL alive;
+
+            if (AttemptSemaphore(&running->hs_Done))
+            {
+                held = TRUE;
+                break;
+            }
+            Forbid();
+            alive = TaskIsListed(running->hs_Starter);
+            Permit();
+            if (!alive)
+                break;
+            Delay(2);
+        }
+        if (held)
+        {
+            /* What the starter achieved, also for a handler that keeps
+               dn_Task NULL and answers on a port of its own. */
+            port = running->hs_Result ? running->hs_Result : deviceNode->dn_Task;
+            ReleaseSemaphore(&running->hs_Done);
+            DropHandlerStart(running);
+            ReleaseSemaphore(&mine->hs_Done);
+            FreeMem(mine, sizeof(*mine));
+            return port;
+        }
+        /* The starter died: look again, which removes its entry, and start
+           the handler here. */
+        DropHandlerStart(running);
+    }
+
+    /* A start that finished between the caller's look at dn_Task and here. */
+    port = deviceNode->dn_Task;
+    if (port == NULL)
+        port = StartHandler(deviceNode, path, DOSBase);
+    mine->hs_Result = port;
+
+    Forbid();
+    Remove((struct Node *)&mine->hs_Node);
+    Permit();
+    ReleaseSemaphore(&mine->hs_Done);
+    DropHandlerStart(mine);
+    return port;
+}
+
