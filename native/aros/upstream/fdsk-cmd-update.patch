+/**************************************************************************/
 
+/*
+ * Write barrier: ask the handler that owns the backing file to commit its
+ * buffers. DOS has no per-file sync packet, so this is the handler-wide
+ * ACTION_FLUSH. A handler that does not know the action keeps the previous
+ * behaviour (success); every other failure is reported to the filesystem,
+ * which must not treat the barrier as passed.
+ */
+static LONG update(struct unit *unit)
+{
+    struct FileHandle *fh = (struct FileHandle *)BADDR(unit->file);
+
+    if (!unit->writable)
+        return 0;
+    if (!DoPkt(fh->fh_Type, ACTION_FLUSH, 0, 0, 0, 0, 0)
+        && IoErr() != ERROR_ACTION_NOT_KNOWN)
+        return error(IoErr());
     return 0;
 }
 
