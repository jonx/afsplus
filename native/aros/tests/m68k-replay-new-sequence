C:FailAt 21
Assign "FDSK:" "SYS:DiskImages"
C:Mount DEVS:DOSDrivers/AFSPLUS19 >HOST:mount.out
If WARN
    C:Echo fail >HOST:mount.status
Else
    C:Echo pass >HOST:mount.status
    C:AFSPlusReplayProbe new >HOST:replay.out
    If WARN
        C:Echo fail >HOST:replay.status
    Else
        C:Echo pass >HOST:replay.status
    EndIf
    C:Mount AFSPLUS19: SHUTDOWN >HOST:shutdown.out
    If WARN
        C:Echo fail >HOST:shutdown.status
    Else
        C:Echo pass >HOST:shutdown.status
        C:Assign AFSPLUS19: DISMOUNT >HOST:dismount.out
        If WARN
            C:Echo fail >HOST:dismount.status
        Else
            C:Echo pass >HOST:dismount.status
        EndIf
    EndIf
EndIf
C:Shutdown
