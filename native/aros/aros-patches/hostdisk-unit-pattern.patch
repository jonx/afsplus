+ * fstat. Use struct stat, as emul-handler's unix_hints.h does.
+ */
+#define stat64 stat
 #else
 
 /*
@@ -61,6 +69,8 @@
 #include <proto/hostlib.h>
 #include <proto/intuition.h>
 #include <proto/kernel.h>
+#include <proto/bootloader.h>
+#include <aros/bootloader.h>
 
 #ifdef HOST_LONG_ALIGNED
 #pragma pack(4)
@@ -185,6 +195,61 @@ LONG Host_Write(struct unit *Unit, APTR buf, ULONG size, ULONG *ioerr)
     return ret;
 }
 
+/*
+ * Darwin's F_FULLFSYNC, spelled out because <sys/fcntl.h> cannot be reached
+ * from an AROS compile, the way geometry.c spells out the DKIOC requests.
+ * fsync() on Darwin only hands the data to the drive; F_FULLFSYNC also asks
+ * the drive to empty its own write cache, which is what CMD_UPDATE promises.
+ */
+#define HOST_F_FULLFSYNC 51
+
+ULONG Host_Flush(struct unit *Unit)
+{
+    struct HostDiskBase *hdskBase = Unit->hdskBase;
+    int res, err;
+
+    D(bug("hostdisk: sync unit %s\n", Unit->n.ln_Name));
+
+    /* An ejected unit has nothing to sync. */
+    if (Unit->file == INVALID_HANDLE_VALUE)
+        return 0;
+
+    HostLib_Lock();
+
+#ifdef HOST_OS_darwin
+    res = hdskBase->iface->fcntl(Unit->file, HOST_F_FULLFSYNC, 0);
+    AROS_HOST_BARRIER
+    err = *hdskBase->errnoPtr;
+
+    if (res == -1)
+    {
+        /*
+         * Not every Darwin file system implements F_FULLFSYNC; fsync() still
+         * gets the data out of the host kernel.
+         */
+        D(bug("hostdisk: F_FULLFSYNC failed with %d, falling back to fsync\n", err));
+
+        res = hdskBase->iface->fsync(Unit->file);
+        AROS_HOST_BARRIER
+        err = *hdskBase->errnoPtr;
+    }
+#else
+    res = hdskBase->iface->fsync(Unit->file);
+    AROS_HOST_BARRIER
+    err = *hdskBase->errnoPtr;
+#endif
+
+    HostLib_Unlock();
+
+    if (res == -1)
+    {
+        D(bug("hostdisk: sync failed, UNIX error %d\n", err));
+        return error(err);
+    }
+
+    return 0;
+}
+
 ULONG Host_Seek(struct unit *Unit, ULONG pos)
 {
     return Host_Seek64(Unit, pos, 0);
@@ -306,6 +371,8 @@ static const char *libcSymbols[] =
     "fstat64" INODE64_SUFFIX,
     "stat64" INODE64_SUFFIX,
 #endif
+    "fsync",
+    "fcntl",
     NULL
 };
 
@@ -344,6 +411,54 @@ static BOOL CheckArch(const char *Component, const char *MyArch, const char *Sys
     return TRUE;
 }
 
+/*
+ * hostdisk=PATTERN on the kernel command line replaces the host path of unit
+ * N, "/dev/disk%ld" by default, so that a boot can take its disks from image
+ * files instead of the machine's own drives. The pattern must hold exactly
+ * one %ld and no other conversion; any other value is ignored.
+ */
+static void Host_UnitPattern(struct HostDiskBase *hdskBase)
+{
+    APTR BootLoaderBase = OpenResource("bootloader.resource");
+    struct List *args;
+    struct Node *node;
+
+    if (BootLoaderBase == NULL)
+        return;
+    args = GetBootInfo(BL_Args);
+    if (args == NULL)
+        return;
+    ForeachNode(args, node)
+    {
+        STRPTR pattern;
+        STRPTR cursor;
+        ULONG conversions = 0;
+        BOOL valid = TRUE;
+
+        if (strncmp(node->ln_Name, "hostdisk=", 9) != 0)
+            continue;
+        pattern = node->ln_Name + 9;
+        for (cursor = pattern; *cursor; cursor++)
+        {
+            if (*cursor != '%')
+                continue;
+            if (cursor[1] == 'l' && cursor[2] == 'd')
+            {
+                conversions++;
+                cursor += 2;
+            }
+            else
+                valid = FALSE;
+        }
+        if (valid && conversions == 1)
+        {
+            D(bug("hostdisk: unit pattern %s\n", pattern));
+            hdskBase->DiskDevice = pattern;
+            hdskBase->unitBase = 0;
+        }
+    }
+}
+
 static int Host_Init(struct HostDiskBase *hdskBase)
 {
     ULONG r;
@@ -377,6 +492,7 @@ static int Host_Init(struct HostDiskBase *hdskBase)
 
     hdskBase->DiskDevice = DISK_DEVICE;
     hdskBase->unitBase   = DISK_BASE;
+    Host_UnitPattern(hdskBase);
 
     return TRUE;
 }
