 #include <exec/memory.h>
 #include <proto/hostlib.h>
 
-#include <sys/disk.h>
+/*
+ * The two requests of <sys/disk.h>, which cannot be included in an AROS
+ * compile: it pulls in <net/if.h>, whose BSD types AROS does not define.
+ * _IOR('d', 24, uint32_t) and _IOR('d', 25, uint64_t).
+ */
+#define DKIOCGETBLOCKSIZE  0x40046418UL
+#define DKIOCGETBLOCKCOUNT 0x40086419UL
 
 #include "hostdisk_host.h"
 #include "hostdisk_device.h"
