 /* Correspondingly, there's no struct stat64. Use struct stat instead. */
 #define stat64 stat
+#elif defined(HOST_OS_darwin)
+
+/*
+ * Modern macOS, and all of Apple Silicon, has 64-bit inodes only: asking for
+ * the 32-bit inode_t is a compile error, and fstat64 is the same function as
+ * fstat. Use struct stat, as emul-handler's unix_hints.h does.
+ */
+#define stat64 stat
 #else
 
