diff --git a/src/llvm-project/llvm/test/CodeGen/M68k/tail-call-m68000.ll b/src/llvm-project/llvm/test/CodeGen/M68k/tail-call-m68000.ll
new file mode 100644
--- /dev/null
+++ b/src/llvm-project/llvm/test/CodeGen/M68k/tail-call-m68000.ll
@@ -0,0 +1,18 @@
+; RUN: llc -mtriple=m68k -mcpu=M68000 -O2 < %s | FileCheck %s --check-prefix=M68000
+; RUN: llc -mtriple=m68k -mcpu=M68020 -O2 < %s | FileCheck %s --check-prefix=M68020
+
+declare i32 @callee(i32)
+
+define i32 @tail_callee(i32 %value) {
+; M68000-LABEL: tail_callee:
+; M68000-NOT:   bra callee
+; M68000:       jsr callee
+; M68000:       rts
+;
+; M68020-LABEL: tail_callee:
+; M68020:       bra callee
+; M68020-NOT:   rts
+entry:
+  %result = tail call i32 @callee(i32 %value)
+  ret i32 %result
+}
diff --git a/src/llvm-project/llvm/test/CodeGen/M68k/mul-overflow-m68000.ll b/src/llvm-project/llvm/test/CodeGen/M68k/mul-overflow-m68000.ll
new file mode 100644
--- /dev/null
+++ b/src/llvm-project/llvm/test/CodeGen/M68k/mul-overflow-m68000.ll
@@ -0,0 +1,56 @@
+; RUN: llc -mtriple=m68k -mcpu=M68000 -O2 < %s | FileCheck %s --check-prefix=M68000
+; RUN: llc -mtriple=m68k -mcpu=M68020 -O2 < %s | FileCheck %s --check-prefix=M68020
+
+declare { i32, i1 } @llvm.umul.with.overflow.i32(i32, i32)
+declare { i32, i1 } @llvm.smul.with.overflow.i32(i32, i32)
+
+define i1 @unsigned_overflow(i32 %left, i32 %right, ptr %product) {
+; M68000-LABEL: unsigned_overflow:
+; M68000-NOT:   mulu.l
+; M68000:       jsr __muldi3
+; M68000-NOT:   mulu.l
+; M68000:       rts
+;
+; M68020-LABEL: unsigned_overflow:
+; M68020:       mulu.l
+entry:
+  %pair = call { i32, i1 } @llvm.umul.with.overflow.i32(i32 %left, i32 %right)
+  %value = extractvalue { i32, i1 } %pair, 0
+  %overflow = extractvalue { i32, i1 } %pair, 1
+  store i32 %value, ptr %product
+  ret i1 %overflow
+}
+
+define i1 @signed_overflow(i32 %left, i32 %right, ptr %product) {
+; M68000-LABEL: signed_overflow:
+; M68000-NOT:   muls.l
+; M68000:       jsr __muldi3
+; M68000-NOT:   muls.l
+; M68000:       rts
+;
+; M68020-LABEL: signed_overflow:
+; M68020:       muls.l
+entry:
+  %pair = call { i32, i1 } @llvm.smul.with.overflow.i32(i32 %left, i32 %right)
+  %value = extractvalue { i32, i1 } %pair, 0
+  %overflow = extractvalue { i32, i1 } %pair, 1
+  store i32 %value, ptr %product
+  ret i1 %overflow
+}
+
+define i32 @unsigned_constant_overflow(i32 %left) {
+; M68000-LABEL: unsigned_constant_overflow:
+; M68000-NOT:   mulu.l
+; M68000:       jsr __muldi3
+; M68000-NOT:   mulu.l
+; M68000:       rts
+;
+; M68020-LABEL: unsigned_constant_overflow:
+; M68020:       mulu.l
+entry:
+  %pair = call { i32, i1 } @llvm.umul.with.overflow.i32(i32 %left, i32 32384)
+  %value = extractvalue { i32, i1 } %pair, 0
+  %overflow = extractvalue { i32, i1 } %pair, 1
+  %selected = select i1 %overflow, i32 -1, i32 %value
+  ret i32 %selected
+}
